config PEROVSAT_EYESTAR
	bool "EYESTAR driver"
	depends on DT_HAS_NEARSPACELAUNCH_EYESTAR_ENABLED
	help
	  Enable the EYESTAR Zephyr driver module.

if PEROVSAT_EYESTAR

choice
	prompt "EYESTAR backend"
	default PEROVSAT_EYESTAR_BACKEND_PUBLIC_MOCK

config PEROVSAT_EYESTAR_BACKEND_HARDWARE
	bool "Hardware (real device over bus)"
	help
	  Link lib/eyestar.c with src/hardware_transfer.c.
	  Fill in that file when bringing the chip up.
	  FILL IN: add "select I2C" (or SPI / SERIAL) on this symbol to match
	  the part.

config PEROVSAT_EYESTAR_BACKEND_LIBRARY_MOCK
	bool "Library mock (lib/ without hardware)"
	help
	  Link lib/eyestar.c with src/lib_mock_transfer.c.

config PEROVSAT_EYESTAR_BACKEND_PUBLIC_MOCK
	bool "Public mock (hardcoded data, no library required)"
	help
	  Link mock/eyestar.c instead of lib/eyestar.c.
	  Safe for CI and repos without NDA library access.

endchoice

endif
